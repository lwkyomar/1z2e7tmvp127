<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Семейный GPS-Трекер"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Оффлайн-накопление координат и автовыгрузка"
            android:textSize="14sp"
            android:textColor="#94A3B8"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Статус: Остановлен"
            android:textColor="#EF4444"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="12dp"
            android:background="#1E293B"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvUnsynced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Неотправленных точек в памяти: 0"
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Всего сохранено точек: 0"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Запустить трекинг"
            android:textSize="16sp"
            android:backgroundTint="#4F46E5"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSyncNow"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Отправить накопленные точки сейчас"
            android:backgroundTint="#0284C7"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Отключить оптимизацию батареи"
            android:backgroundTint="#D97706"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Параметры подключения"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID устройства (например: son-xiaomi-poco)"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etSupabaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Supabase URL (https://xyz.supabase.co)"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/etSupabaseKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Supabase Anon Key"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
